# Copy to .env and fill in. .env is gitignored.

# Database container. Host port is 5434 to avoid clashing with ShipBox (5433)
# and a native Postgres.
POSTGRES_USER=boost_my_spot
POSTGRES_PASSWORD=
POSTGRES_DB=boost_my_spot
POSTGRES_PORT=5434

DATABASE_URL="postgresql://boost_my_spot:PASSWORD@127.0.0.1:5434/boost_my_spot?schema=public"

# API server. Keep 127.0.0.1 locally; a hosting platform will require 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development

# Opens an email and password sign-in, for the browser tests only. The API
# refuses to start with this on in production.
E2E_AUTH=false

# How many requests one caller may send to /api per minute.
RATE_LIMIT_PER_MINUTE=120

# How many PostgreSQL connections one instance may hold.
DATABASE_POOL_MAX=10

# How many proxies sit in front of the API. 0 locally.
TRUSTED_PROXY_HOPS=0

# Public origin of the frontend.
WEB_ORIGIN="http://localhost:5174"

# Public base URL the auth endpoints are reached at. In development the Vite
# proxy means that is the frontend port, not the API port.
BETTER_AUTH_URL="http://localhost:5174"

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# OAuth providers for the back-office. Set both halves of a pair or neither.
# At least one provider is required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Order processing secrets ────────────────────────────────────────────────
# Seals the Spotify session cookie at rest. 32 bytes as 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_BOX_KEY=
# Signs the stateless order-tracking link. At least 32 characters.
ORDER_LINK_SECRET=

# ── upgrader.cc reseller API ────────────────────────────────────────────────
# In development these point at scripts/fake-upstream.ts on port 3199.
UPGRADER_API_URL="https://upgrader.cc/api"
UPGRADER_API_KEY=

# ── NOWPayments (crypto) ────────────────────────────────────────────────────
NOWPAYMENTS_API_URL="https://api.nowpayments.io/v1"
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_URL="https://api.resend.com"
RESEND_API_KEY=
MAIL_FROM="boost-my-spot <orders@example.com>"

# Comma-separated emails allowed to sign in to the back-office.
ADMIN_EMAILS=admin@example.com
